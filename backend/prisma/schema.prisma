generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Order {
  id            Int       @id @default(autoincrement())
  sallaOrderId  String    @unique @map("salla_order_id") @db.VarChar(255)
  sallaData     Json      @map("salla_data")
  eventType     String?   @map("event_type") @db.VarChar(100)
  storeId       String?   @map("store_id") @db.VarChar(255)
  edaraStatus   String    @default("pending") @map("edara_status") @db.VarChar(50)
  retryCount    Int       @default(0) @map("retry_count")
  lastError     String?   @map("last_error")
  masaResponse  Json?     @map("masa_response")
  providerRef   String?   @map("provider_ref") @db.VarChar(255)
  source        String?   @default("webhook") @map("source") @db.VarChar(50)
  sallaOrderAt  DateTime? @map("salla_order_at") @db.Timestamptz()
  masaSentAt    DateTime? @map("masa_sent_at") @db.Timestamptz()
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([edaraStatus], name: "idx_orders_status")
  @@index([createdAt], name: "idx_orders_created_at")
  @@map("orders")
}

model BrandMapping {
  id             Int      @id @default(autoincrement())
  keyword        String   @db.VarChar(100)
  brandCode      String   @map("brand_code") @db.VarChar(50)
  description    String?  @db.VarChar(255)
  credentialMode String?  @map("credential_mode") @db.VarChar(50)
  clientId       Int?     @map("client_id")
  client         Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("brand_mappings")
}

model Client {
  id                  Int          @id @default(autoincrement())
  name                String       @db.VarChar(255)
  slug                String       @unique @db.VarChar(100)
  sallaClientId       String       @map("salla_client_id") @db.VarChar(255)
  sallaClientSecret   String       @map("salla_client_secret")
  sallaRedirectUri    String       @map("salla_redirect_uri")
  sallaWebhookSecret  String?      @map("salla_webhook_secret")
  hubApiKey           String?      @map("supplier_api_key")
  masaClientId        String?      @map("supplier_client_id") @db.VarChar(255)
  xEnvironment        String       @default("production") @map("supplier_environment") @db.VarChar(50)
  supplierBaseUrl     String?      @map("supplier_base_url")
  supplierApiKeyUrl   String?      @map("supplier_api_key_url")
  playerIdField     String       @default("الأيدي") @map("player_id_field") @db.VarChar(255)
  telegramBotToken  String?      @map("telegram_bot_token")
  telegramChatId    String?      @map("telegram_chat_id") @db.VarChar(100)
  blockOrdersAfterMinutes Int?    @map("block_orders_after_minutes")
  isActive            Boolean        @default(true) @map("is_active")
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt           DateTime       @updatedAt @map("updated_at") @db.Timestamptz()
  tokens              SallaToken[]
  brandMappings       BrandMapping[]

  @@index([slug], name: "idx_tenants_slug")
  @@map("tenants")
}

model SallaToken {
  id           Int      @id @default(autoincrement())
  storeId      String   @unique @map("store_id") @db.VarChar(255)
  clientId     Int?     @map("tenant_id")
  client       Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  accessToken  String   @map("access_token")
  refreshToken String   @map("refresh_token")
  expiresIn    Int      @map("expires_in")
  expiresAt    DateTime @map("expires_at") @db.Timestamptz()
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([storeId], name: "idx_salla_tokens_store_id")
  @@index([clientId], name: "idx_salla_tokens_tenant_id")
  @@map("salla_tokens")
}

model PollLog {
  id               Int       @id @default(autoincrement())
  startedAt        DateTime  @default(now()) @map("started_at") @db.Timestamptz()
  finishedAt       DateTime? @map("finished_at") @db.Timestamptz()
  ordersFound      Int       @default(0) @map("orders_found")
  ordersProcessed  Int       @default(0) @map("orders_processed")
  ordersSkipped    Int       @default(0) @map("orders_skipped")
  status           String    @default("running") @map("status") @db.VarChar(20)
  error            String?
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  @@index([startedAt(sort: Desc)], name: "idx_poll_logs_started_at")
  @@map("poll_logs")
}

model OrderLock {
  sallaOrderId  String   @id @map("salla_order_id") @db.VarChar(255)
  claimedAt     DateTime @default(now()) @map("claimed_at") @db.Timestamptz()

  @@map("order_locks")
}

model AdminUser {
  id           Int      @id @default(autoincrement())
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash")
  totpSecret   String?  @map("totp_secret")
  totpEnabled  Boolean  @default(false) @map("totp_enabled")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([email], name: "idx_admin_users_email")
  @@map("admin_users")
}
